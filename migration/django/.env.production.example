# Copy selected placeholders to an ignored .env or the future server secret store.
# These example values cannot identify a host, project, account, or live secret.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-private-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=voiceform.example.invalid
DJANGO_PUBLIC_ORIGIN=https://voiceform.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://voiceform.example.invalid
DJANGO_SECURE_SSL_REDIRECT=true
# Set HSTS only after the owner selects and verifies the permanent HTTPS host.
DJANGO_HSTS_SECONDS=0

# Keep the established restricted roles and alias split. Percent-encode reserved characters.
DJANGO_DATABASE_URL=postgresql://django_app:replace-me@your-project.pooler.supabase.com:6543/postgres?sslmode=require
DJANGO_SUPABASE_DATABASE_URL=postgresql://django_data:replace-me@your-project.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
AUTH_TIMEOUT_SECONDS=8

# Waitress binds to loopback. A same-host TLS proxy forwards Host and X-Forwarded-For.
# The proxy must remove client copies of X-VoiceForm-Proxy-Token and inject this private value.
P10_BIND_HOST=127.0.0.1
P10_BIND_PORT=8000
P10_THREADS=8
P10_TRUSTED_PROXY_IP=127.0.0.1
DJANGO_STATIC_ROOT=.state/staticfiles
DJANGO_LOG_FILE=.state/logs/voiceform.log

# Keep endpoints disabled until the owner chooses provider modes and enables the proxy route.
P3_SERVICES_ENABLED=false
P3_SERVICE_ACCESS_MODE=trusted-proxy
P3_PROXY_TOKEN=replace-with-at-least-32-random-private-characters
P3_ALLOWED_ORIGINS=https://voiceform.example.invalid
INTERNAL_API_TOKEN=replace-with-a-random-request-marker
P3_PROVIDER_TIMEOUT_SECONDS=15
SPEECH_BACKEND=mock
TTS_BACKEND=mock
USE_MOCK_AI=true
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Public Auth API values only. Do not put a Supabase secret/service-role key here.
P6_LEGACY_FALLBACK_ENABLED=false
P6_LEGACY_ORIGIN=
P6_PREVIEW_ENABLED=false
P7_LEGACY_ROLLBACK_ROUTES=
