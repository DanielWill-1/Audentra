# Copy to .env and fill with the two restricted role URLs after bootstrap.
DJANGO_SECRET_KEY=replace-with-a-long-random-local-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# PostgreSQL URLs must use django_app and django_data, never an elevated role.
# Percent-encode reserved characters in user names and passwords.
DJANGO_DATABASE_URL=postgresql://django_app:replace-me@db.example.supabase.co:5432/postgres?sslmode=require
DJANGO_SUPABASE_DATABASE_URL=postgresql://django_data:replace-me@db.example.supabase.co:5432/postgres?sslmode=require

DJANGO_STATIC_ROOT=

# P3 provider services are off by default and limited to a loopback development server.
P3_SERVICES_ENABLED=false
P3_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INTERNAL_API_TOKEN=voiceform-p3
P3_PROVIDER_TIMEOUT_SECONDS=15
SPEECH_BACKEND=mock
TTS_BACKEND=mock
USE_MOCK_AI=true

# Live speech requires a private service-account file or Application Default Credentials.
# Never commit the credential file. The default mock backends need no provider access.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json

# Owner selected GPT OSS 120B after checking current Groq model availability.
# Live extraction stays off until deliberately enabled for a bounded smoke.
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Public Auth API settings. Never place a secret or service-role key here.
SUPABASE_URL=https://your_test_project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_key
DJANGO_PUBLIC_ORIGIN=http://127.0.0.1:8000
AUTH_TIMEOUT_SECONDS=8
