--
-- Name: template_reviews Users can view template reviews; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can view template reviews" ON public.template_reviews FOR SELECT TO authenticated USING (((EXISTS ( SELECT 1
   FROM public.templates
  WHERE ((templates.id = template_reviews.template_id) AND (templates.visibility = 'visible'::text)))) OR (EXISTS ( SELECT 1
   FROM public.templates
  WHERE ((templates.id = template_reviews.template_id) AND (templates.created_by = auth.uid())))) OR (EXISTS ( SELECT 1
   FROM public.template_shares
  WHERE ((template_shares.template_id = template_reviews.template_id) AND ((template_shares.user_id = auth.uid()) OR (template_shares.user_email = (( SELECT users.email
           FROM auth.users
          WHERE (users.id = auth.uid())))::text)))))));


--
-- Name: template_shares Users can view their own shares; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can view their own shares" ON public.template_shares FOR SELECT TO authenticated USING (((user_id = auth.uid()) OR (user_email = (( SELECT users.email
   FROM auth.users
  WHERE (users.id = auth.uid())))::text)));


