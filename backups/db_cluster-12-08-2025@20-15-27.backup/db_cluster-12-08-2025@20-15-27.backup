-- Name: contact_submissions Authenticated users can view all contact submissions; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Authenticated users can view all contact submissions" ON public.contact_submissions FOR SELECT TO authenticated USING (true);


--
-- Name: team_invites Team admins can manage invites; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Team admins can manage invites" ON public.team_invites TO authenticated USING (((EXISTS ( SELECT 1
   FROM public.teams
  WHERE ((teams.id = team_invites.team_id) AND (teams.owner_id = auth.uid())))) OR (EXISTS ( SELECT 1
   FROM public.team_members tm
  WHERE ((tm.team_id = team_invites.team_id) AND (tm.user_id = auth.uid()) AND (tm.role = 'admin'::text) AND (tm.status = 'active'::text)))))) WITH CHECK (((EXISTS ( SELECT 1
   FROM public.teams
  WHERE ((teams.id = team_invites.team_id) AND (teams.owner_id = auth.uid())))) OR (EXISTS ( SELECT 1
   FROM public.team_members tm
  WHERE ((tm.team_id = team_invites.team_id) AND (tm.user_id = auth.uid()) AND (tm.role = 'admin'::text) AND (tm.status = 'active'::text))))));


--
-- Name: team_members Team admins can manage team members; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Team admins can manage team members" ON public.team_members TO authenticated USING (((EXISTS ( SELECT 1
   FROM public.teams
  WHERE ((teams.id = team_members.team_id) AND (teams.owner_id = auth.uid())))) OR (EXISTS ( SELECT 1
   FROM public.team_members tm
  WHERE ((tm.team_id = team_members.team_id) AND (tm.user_id = auth.uid()) AND (tm.role = 'admin'::text) AND (tm.status = 'active'::text)))))) WITH CHECK (((EXISTS ( SELECT 1
   FROM public.teams
  WHERE ((teams.id = team_members.team_id) AND (teams.owner_id = auth.uid())))) OR (EXISTS ( SELECT 1
   FROM public.team_members tm
  WHERE ((tm.team_id = team_members.team_id) AND (tm.user_id = auth.uid()) AND (tm.role = 'admin'::text) AND (tm.status = 'active'::text))))));


--
-- Name: team_activity Team members can create activity; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Team members can create activity" ON public.team_activity FOR INSERT TO authenticated WITH CHECK (((user_id = auth.uid()) AND ((EXISTS ( SELECT 1
   FROM public.team_members tm
  WHERE ((tm.team_id = team_activity.team_id) AND (tm.user_id = auth.uid()) AND (tm.status = 'active'::text)))) OR (EXISTS ( SELECT 1
   FROM public.teams
  WHERE ((teams.id = team_activity.team_id) AND (teams.owner_id = auth.uid())))))));


--
-- Name: team_activity Team members can view team activity; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Team members can view team activity" ON public.team_activity FOR SELECT TO authenticated USING (((EXISTS ( SELECT 1
   FROM public.team_members tm
  WHERE ((tm.team_id = team_activity.team_id) AND (tm.user_id = auth.uid()) AND (tm.status = 'active'::text)))) OR (EXISTS ( SELECT 1
   FROM public.teams
  WHERE ((teams.id = team_activity.team_id) AND (teams.owner_id = auth.uid()))))));


--
-- Name: team_members Team members can view team members; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Team members can view team members" ON public.team_members FOR SELECT TO authenticated USING (((EXISTS ( SELECT 1
   FROM public.team_members tm
  WHERE ((tm.team_id = team_members.team_id) AND (tm.user_id = auth.uid()) AND (tm.status = 'active'::text)))) OR (EXISTS ( SELECT 1
   FROM public.teams
  WHERE ((teams.id = team_members.team_id) AND (teams.owner_id = auth.uid()))))));


--
-- Name: teams Team members can view their teams; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Team members can view their teams" ON public.teams FOR SELECT TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.team_members
  WHERE ((team_members.team_id = teams.id) AND (team_members.user_id = auth.uid()) AND (team_members.status = 'active'::text)))));


--
-- Name: teams Team owners can manage their teams; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Team owners can manage their teams" ON public.teams TO authenticated USING ((owner_id = auth.uid())) WITH CHECK ((owner_id = auth.uid()));


--
-- Name: template_shares Template owners can create shares; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Template owners can create shares" ON public.template_shares FOR INSERT TO authenticated WITH CHECK (((shared_by = auth.uid()) AND (EXISTS ( SELECT 1
   FROM public.templates
  WHERE ((templates.id = template_shares.template_id) AND (templates.created_by = auth.uid()))))));


--
-- Name: template_shares Template owners can delete shares; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Template owners can delete shares" ON public.template_shares FOR DELETE TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.templates
  WHERE ((templates.id = template_shares.template_id) AND (templates.created_by = auth.uid())))));


--
-- Name: template_reviews Template owners can update review status; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Template owners can update review status" ON public.template_reviews FOR UPDATE TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.templates
  WHERE ((templates.id = template_reviews.template_id) AND (templates.created_by = auth.uid()))))) WITH CHECK ((EXISTS ( SELECT 1
   FROM public.templates
  WHERE ((templates.id = template_reviews.template_id) AND (templates.created_by = auth.uid())))));


--
-- Name: template_shares Template owners can update shares; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Template owners can update shares" ON public.template_shares FOR UPDATE TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.templates
  WHERE ((templates.id = template_shares.template_id) AND (templates.created_by = auth.uid())))));


--
-- Name: template_shares Template owners can view shares; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Template owners can view shares" ON public.template_shares FOR SELECT TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.templates
  WHERE ((templates.id = template_shares.template_id) AND (templates.created_by = auth.uid())))));


--
-- Name: scheduled_events Users can create own scheduled events; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can create own scheduled events" ON public.scheduled_events FOR INSERT TO authenticated WITH CHECK ((created_by = auth.uid()));


--
-- Name: template_reviews Users can create reviews; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can create reviews" ON public.template_reviews FOR INSERT TO authenticated WITH CHECK (((reviewer_id = auth.uid()) AND ((EXISTS ( SELECT 1
   FROM public.templates
  WHERE ((templates.id = template_reviews.template_id) AND (templates.visibility = 'visible'::text)))) OR (EXISTS ( SELECT 1
   FROM public.template_shares
  WHERE ((template_shares.template_id = template_reviews.template_id) AND ((template_shares.user_id = auth.uid()) OR (template_shares.user_email = (( SELECT users.email
           FROM auth.users
          WHERE (users.id = auth.uid())))::text)))))) AND (NOT (EXISTS ( SELECT 1
   FROM public.templates
  WHERE ((templates.id = template_reviews.template_id) AND (templates.created_by = auth.uid())))))));


--
-- Name: template_reviews Users can delete own reviews; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can delete own reviews" ON public.template_reviews FOR DELETE TO authenticated USING ((reviewer_id = auth.uid()));


