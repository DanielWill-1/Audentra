# Supabase Configuration
# The anon key is public by design (it is delivered to the browser); Row Level Security
# is the authorization boundary. Never put a service_role key in a VITE_ variable.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# P1 parity CLI settings (literal values; existing process settings override .env).
# "staging" includes the owner's hosted development/testing project.
# Keep this URL/anon key aligned with the VITE_ settings above.
# The scripts load only PARITY_ names from .env and never print key values.
PARITY_TARGET_KIND=staging
PARITY_ALLOWED_SUPABASE_HOSTS=your_test_project.supabase.co
PARITY_SUPABASE_URL=https://your_test_project.supabase.co
PARITY_SUPABASE_ANON_KEY=your_test_project_anon_key
# Auth identities, elevated fixture credentials and fixture writes are deferred.
# PARITY_SUPABASE_SERVICE_ROLE_KEY=
# PARITY_TEST_USER_ID=
# PARITY_TEST_EMAIL=parity@example.test
# PARITY_TEST_PASSWORD=
# PARITY_ALLOW_FIXTURE_WRITES=I_CONFIRM_ISOLATED_TEST_DATA

# Google Cloud Configuration (SERVER-SIDE ONLY)
# The Express backend authenticates with a Google service-account JSON file referenced by
# path (kept OUTSIDE git and gitignored), or via GOOGLE_APPLICATION_CREDENTIALS.
# Never expose Google Cloud credentials to the browser, and never use a VITE_-prefixed
# variable for them: Vite inlines every VITE_ value into the shipped client bundle.
# See docs/security-remediation.md.

# Groq (SERVER-SIDE ONLY)
# Introduced by P3 of docs/python-migration-plan.md. Do NOT add VITE_GROQ_API_KEY --
# the previous VITE_ variable was inlined into the public client bundle and had to be
# rotated. The client keeps its mock fallback unless the P3 transport switch is enabled.
# GROQ_API_KEY=

# P3 Django speech/extraction transport (all values below are public browser settings).
# Enable only after migration/django/.env has matching local server settings.
VITE_USE_DJANGO_SERVICES=false
VITE_DJANGO_API_BASE_URL=http://127.0.0.1:8000
VITE_INTERNAL_API_TOKEN=voiceform-p3
